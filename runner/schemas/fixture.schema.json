{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The-Test Fixture Runtime Artifact",
  "description": "Non-evidentiary runner fixture data. This is not the canonical RUN contract.",
  "type": "object",
  "required": [
    "run_id",
    "exp_id",
    "variant",
    "runner_version",
    "schema_version",
    "operator",
    "start_time",
    "end_time",
    "status",
    "environment_manifest_path",
    "events_path",
    "receipt_path",
    "derived_metrics",
    "fixture_verified",
    "failure_stage"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^(FIXTURE-|TEST-RUN-)"},
    "exp_id": {"type": "string", "pattern": "^EXP-[0-9]{3,}$"},
    "variant": {"type": "string", "enum": ["A", "B", "C"]},
    "exp_commit": {"type": ["string", "null"]},
    "runner_version": {"type": "string"},
    "schema_version": {"type": "string"},
    "operator": {"type": "string"},
    "start_time": {"type": "string", "format": "date-time"},
    "end_time": {"type": "string", "format": "date-time"},
    "status": {"const": "completed"},
    "environment_manifest_path": {"type": "string"},
    "events_path": {"type": "string"},
    "receipt_path": {"type": "string"},
    "artifacts": {"type": "array"},
    "derived_metrics": {"type": "object"},
    "notes": {"type": "string"},
    "fixture_verified": {"type": "boolean"},
    "failure_stage": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
